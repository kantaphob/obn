generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Entry {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("ทั่วไป")
  description String   @default("")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model CompanyLedgerEntry {
  id                String                  @id @default(cuid())
  type              String // INCOME or EXPENSE
  title             String
  category          String
  financeCategoryId String?
  financeCategory   CompanyFinanceCategory? @relation(fields: [financeCategoryId], references: [id], onDelete: SetNull)
  amount            Int // satang
  baseAmount        Int?
  vatRateBps        Int?
  vatAmount         Int?
  whtRateBps        Int?
  whtAmount         Int?
  transactionDate   DateTime
  timeRecorded      Boolean                 @default(false)
  documentNumber    String?                 @unique
  companyCode       String?
  branchCode        String?
  party             String                  @default("")
  method            String                  @default("CASH")
  reference         String                  @default("")
  note              String                  @default("")
  attachmentUrl     String?
  investorId        String?
  investorSnapshot  String?
  reversalOfId      String?                  @unique
  receiptBreakdown  String?
  reversalOfType    String?
  createdBy         String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([transactionDate])
  @@index([type, transactionDate])
  @@index([category])
  @@index([financeCategoryId])
}

model CompanyFinanceCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  direction String // INCOME or EXPENSE
  name      String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries CompanyLedgerEntry[]

  @@unique([direction, name])
  @@index([direction, isActive])
}

model CompanyLedgerNumberSequence {
  id          String @id @default(cuid())
  companyCode String
  branchCode  String
  year        Int
  lastNumber  Int    @default(0)

  @@unique([companyCode, branchCode, year])
}

//---------------------------------------------------
// master data
//---------------------------------------------------
enum MaterialCategory {
  BUILDING_MATERIAL // วัสดุก่อสร้าง
  ELECTRICAL_MATERIAL // วัสดุไฟฟ้า
  PLUMBING_MATERIAL // วัสดุประปา
  PAINT_MATERIAL // วัสดุทาสี
  FURNITURE_MATERIAL // วัสดุเฟอร์นิเจอร์
  OTHER_MATERIAL // วัสดุอื่นๆ
}

enum MaterialUnitCategory {
  LENGTH // ความยาว
  AREA // พื้นที่
  VOLUME // ปริมาตร
  WEIGHT // น้ำหนัก
  QUANTITY // จำนวน
  OTHER // อื่นๆ
}

enum MasterDataKind {
  THING // สิ่งของและสินค้า
  MATERIAL // วัสดุก่อสร้าง
  UNIT // หน่วยนับ
  CLASSIFIER // ลักษณนาม
  POSTCODE // รหัสไปรษณีย์
}

model Province {
  id             Int               @id @map("province_id")
  nameTh         String            @map("name_th")
  nameEn         String            @map("name_en")
  districts      District[]
  ownerCompanies CompanySequence[] @relation("CompanyOwnerProvince")
  companyOwners  CompanyOwner[]    @relation("CompanyOwnerPostcodeProvince")

  @@map("province")
}

model District {
  id             Int               @id @map("district_id")
  provinceId     Int               @map("province_id")
  nameTh         String            @map("name_th")
  nameEn         String            @map("name_en")
  province       Province          @relation(fields: [provinceId], references: [id])
  subdistricts   Subdistrict[]
  ownerCompanies CompanySequence[] @relation("CompanyOwnerDistrict")
  companyOwners  CompanyOwner[]    @relation("CompanyOwnerPostcodeDistrict")

  @@index([provinceId])
  @@map("district")
}

model Subdistrict {
  id             Int               @id @map("subdistrict_id")
  districtId     Int               @map("district_id")
  nameTh         String            @map("name_th")
  nameEn         String            @map("name_en")
  latitude       Float?            @map("lat")
  longitude      Float?            @map("long")
  postcode       String?           @map("zipcode")
  district       District          @relation(fields: [districtId], references: [id])
  borrowers      borrowers[]
  ownerCompanies CompanySequence[] @relation("CompanyOwnerSubdistrict")
  companyOwners  CompanyOwner[]    @relation("CompanyOwnerPostcodeSubdistrict")

  @@index([districtId])
  @@index([postcode])
  @@map("subdistrict")
}

model Unit {
  code          String     @id
  nameTh        String
  nameEn        String
  symbol        String
  category      String
  standard      String
  sourceUrl     String
  sourceVersion String
  sourceDate    String
  materials     Material[]

  @@index([category])
}

model Material {
  code                String  @id
  nameTh              String
  nameEn              String
  category            String
  recommendedUnitCode String?
  recommendedUnit     Unit?   @relation(fields: [recommendedUnitCode], references: [code], onDelete: Restrict)
  sourceUrl           String
  sourceVersion       String
  sourceDate          String

  @@index([category])
  @@index([recommendedUnitCode])
}

model Classifier {
  code          String @id
  nameTh        String @unique
  nameEn        String
  category      String
  examples      String
  sourceUrl     String
  sourceVersion String
  sourceDate    String

  @@index([category])
}

model Banking {
  id         String      @id @default(cuid())
  bankCode   String      @unique
  bankShort  String
  bankFull   String
  bankNameTH String
  bankNameEN String
  borrowers  borrowers[]

  @@index([bankCode])
}

model Company {
  id          String   @id @default(cuid())
  companyCode String   @unique
  name        String
  taxId       String
  address     String
  postcode    String
  phone       String
  email       String
  website     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches Branch[]

  @@index([taxId])
  @@index([postcode])
}

model Branch {
  id         String   @id @default(cuid())
  companyId  String
  branchCode String   @unique
  name       String
  address    String
  postcode   String
  phone      String
  email      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([postcode])
}

//---------------------------------------------------
// Loan Management
//---------------------------------------------------
// ---------------------- Enums ----------------------

enum RepayType {
  INSTALLMENT // ผ่อนชำระรายเดือน
  INTEREST_ONLY // ผ่อน: จ่ายดอกเรื่อยๆ จนกว่าจะคืนต้น
  LUMP_SUM // จ่ายครั้งเดียวตามวันที่ระบุในสัญญา
}

enum InterestMode {
  UPFRONT // หักดอกล่วงหน้า (ยืม 5,000 ดอก 20% ได้รับ 4,000 คืน 5,000)
  ON_SCHEDULE // เก็บตามสัญญา (ได้รับเต็ม แล้วจ่ายต้น + ดอก)
}

enum InterestRateBasis {
  MONTHLY_FLAT // อัตราคงที่ต่อเดือน คูณจำนวนเดือน
  CONTRACT_FLAT // อัตราครั้งเดียวตลอดสัญญา
}

enum ContractType {
  NONE // ไม่เกินเกณฑ์ ไม่ต้องทำสัญญา
  WITNESS // สัญญากู้ยืม + พยาน
  WITNESS_GUARANTOR // สัญญากู้ยืม + พยาน + ผู้ค้ำ
}

enum ContractStatus {
  DRAFT // ร่าง
  RESERVED // จองสัญญา รอวันเริ่มหรือเงินทุนพร้อม
  AWAITING_DOCUMENT // เกินเกณฑ์ รอสัญญาที่เซ็นแล้ว
  READY // พร้อมจ่ายเงิน
  ACTIVE // จ่ายเงินแล้ว กำลังดำเนินการ
  OVERDUE // เกินกำหนด
  CLOSED // ปิดสัญญา (หนี้สูญให้ปิดพร้อมหมายเหตุ)
  CANCELLED // ยกเลิกก่อนจ่ายเงิน
}

enum SignatureMode {
  PRINT
  DIGITAL
}

enum ScheduleStatus {
  PENDING // รอชำระ
  PAID // ชำระแล้ว
  OVERDUE // เกินกำหนด
}

enum PaymentType {
  DISBURSEMENT // จ่ายเงินให้ลูกหนี้ (เงินออก)
  INTEREST // รับดอกเบี้ย
  PRINCIPAL // รับเงินต้น
  PENALTY // ค่าปรับ
  EXPENSE // ค่าใช้จ่าย (ไม่ผูกสัญญาได้)
  CAPITAL_IN // ใส่ทุน
  CAPITAL_OUT // ถอนทุน
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

// ---------------------- Models ----------------------

enum BorrowerStatus {
  PENDING_REPAYMENT
  UNDER_REVIEW
  CLOSED
}

enum BorrowerPayoutChannel {
  PROMPTPAY
  BANK_TRANSFER
}

enum BorrowerRiskRating {
  SS
  S
  A
  B
  C
  D
}

model BorrowerCodeSequence {
  id    Int @id
  value Int
}

model loanlogs {
  id         String   @id @default(cuid())
  userId     String   @default("guest")
  borrowerId String
  contractId String?
  arId       String?
  apId       String?
  targetId   String?
  action     String
  type       String
  note       String?
  beforeData String?
  afterData  String?
  createdAt  DateTime @default(now())

  @@index([borrowerId])
  @@index([contractId])
  @@index([arId])
  @@index([apId])
  @@index([borrowerId, createdAt])
  @@index([contractId, createdAt])
  @@index([type, targetId])
  @@index([userId, createdAt])
}

model borrowers {
  borrowersCode String  @unique
  id            String  @id @default(cuid())
  nickname      String?
  phone         String
  note          String?

  workplace         String?
  status            BorrowerStatus?
  bankAccountNumber String?
  payoutChannel     BorrowerPayoutChannel?
  payoutBankCode    String?
  payoutBank        Banking?               @relation(fields: [payoutBankCode], references: [bankCode], onDelete: Restrict)
  registeredAt      DateTime?
  facebook          String?
  instagram         String?
  line              String?
  // สถานะจากข้อมูลนำเข้าเดิม
  hasFacebook       Boolean?
  hasInstagram      Boolean?
  hasLine           Boolean?
  riskRating        BorrowerRiskRating?
  approvedLimit     Int? // สตางค์
  usedLimit         Int? // สตางค์
  availableLimit    Int? // สตางค์ ตามข้อมูลนำเข้า
  referrer          String?

  // --- ข้อมูลจากบัตรประชาชน (ทุกช่องไม่บังคับ กรอกเองหรืออ่านจากบัตรก็ได้) ---
  nationalId     String?      @unique // เลข 13 หลัก
  prefixTH       String? // คำนำหน้า (นาย/นาง/นางสาว)
  firstName      String // ชื่อ (ไทย)
  lastName       String? // นามสกุล (ไทย)
  firstNameEN    String?
  lastNameEN     String?
  gender         String?
  birthDate      DateTime?
  address        String? // ที่อยู่ตามบัตร (ข้อความเต็ม)
  houseNumber    String?
  buildingName   String?
  alley          String?
  road           String?
  subdistrictId  Int?
  subdistrict    Subdistrict? @relation(fields: [subdistrictId], references: [id], onDelete: SetNull)
  issueDate      DateTime? // วันออกบัตร
  expiryDate     DateTime? // วันบัตรหมดอายุ
  photoUrl       String? // รูปจากบัตร (เก็บเป็นไฟล์ ไม่เก็บในฐานข้อมูล)
  idCardImageUrl String? // ภาพถ่ายบัตร (ถ้ามี)

  deletedAt       DateTime?
  deletionHistory borrowersdelete[]

  contracts        Contract[]
  loanApplications LoanApplication[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([payoutBankCode])
  @@index([deletedAt])
}

// Keep every deletion event, including events that were subsequently restored.
model borrowersdelete {
  id            String    @id @default(cuid())
  borrowerId    String
  borrower      borrowers @relation(fields: [borrowerId], references: [id], onDelete: Restrict)
  borrowersCode String
  snapshot      String
  reason        String?
  deletedAt     DateTime  @default(now())
  restoredAt    DateTime?

  @@index([borrowerId, deletedAt])
  @@index([restoredAt, deletedAt])
}

model Contract {
  id                     String           @id @default(cuid())
  contractNumber         String           @unique
  previousContractNumber String?          @unique
  renumberedAt           DateTime?
  debtorId               String
  debtor                 borrowers        @relation(fields: [debtorId], references: [id])
  application            LoanApplication?

  // ยอดเงิน (สตางค์)
  principal      Int // เงินต้น
  interestRate   Float // % ต่อสัญญา หรือ ต่อรอบ (ตามที่ตกลง)
  interestAmount Int // ดอกเบี้ย (รวมทั้งสัญญา หรือ ต่อรอบ)
  netDisbursed   Int // ยอดที่ลูกหนี้ได้รับจริง

  // รูปแบบสัญญา
  repayType         RepayType
  interestMode      InterestMode
  interestRateBasis InterestRateBasis @default(CONTRACT_FLAT)
  installmentMonths Int? // จำนวนเดือนสำหรับแผนผ่อน
  periodDays        Int? // รอบจ่ายดอก (INTEREST_ONLY)
  startDate         DateTime
  dueDate           DateTime? // จำเป็นสำหรับ LUMP_SUM

  // สัญญากู้ยืม (เกิน 2,000 บาท)
  contractType    ContractType  @default(NONE)
  documentUrl     String? // ไฟล์สัญญาที่เซ็นแล้ว
  signedAt        DateTime?
  signatureMode   SignatureMode @default(PRINT)
  signatureUrl    String?
  documentData    String?
  consentAccepted Boolean       @default(false)
  consentedAt     DateTime?
  consentText     String?
  witness1        String?
  witness2        String?
  guarantor       String?

  status             ContractStatus @default(DRAFT)
  cancelledAt        DateTime?
  cancellationReason String?
  note               String?
  lateFeePerDay      Int            @default(5000) // สตางค์ต่อวัน
  lateFeeWaived      Boolean        @default(false)

  schedules  InterestSchedule[]
  repayments Repayment[]
  payments   Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([debtorId])
  @@index([status, dueDate])
}

model LoanApplication {
  id               String    @id @default(cuid())
  requestNumber    String    @unique
  losNumber        String?   @unique
  requestType      String    @default("LOAN")
  borrowerId       String
  borrower         borrowers @relation(fields: [borrowerId], references: [id], onDelete: Restrict)
  borrowerSnapshot String
  requestedAmount  Int
  requestedAt      DateTime  @default(now())
  source           String    @default("SYSTEM")
  contractId       String?   @unique
  contract         Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([borrowerId, requestedAt])
}

model LoanApplicationNumberSequence {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// ตารางงวดจ่ายดอก (ใช้กับสัญญาแบบ INTEREST_ONLY)
model InterestSchedule {
  id              String         @id @default(cuid())
  contractId      String
  contract        Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  periodNo        Int
  dueDate         DateTime
  amount          Int // สตางค์
  principalAmount Int            @default(0) // สตางค์
  interestAmount  Int            @default(0) // สตางค์
  status          ScheduleStatus @default(PENDING)
  payments        Payment[]

  @@unique([contractId, periodNo])
}

model ContractNumberSequence {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// รายการเงินเข้า-ออกทั้งหมด (ยอดคงค้าง = รวมจากตารางนี้เสมอ)
model Payment {
  id           String            @id @default(cuid())
  contractId   String? // ว่างได้ สำหรับทุน/ค่าใช้จ่าย
  contract     Contract?         @relation(fields: [contractId], references: [id])
  scheduleId   String?
  schedule     InterestSchedule? @relation(fields: [scheduleId], references: [id])
  type         PaymentType
  amount       Int // สตางค์
  paidAt       DateTime
  timeRecorded Boolean           @default(false)
  method       PaymentMethod     @default(CASH)
  note         String?
  createdAt    DateTime          @default(now())

  @@index([contractId])
  @@index([paidAt])
}

model Repayment {
  reversedAt         DateTime?
  reversedBy         String?
  reversalReason     String?
  id                 String        @id @default(cuid())
  requestKey         String        @unique
  receiptNumber      String        @unique
  contractId         String
  contract           Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  paidAt             DateTime
  timeRecorded       Boolean       @default(false)
  amount             Int
  interestPaid       Int
  penaltyPaid        Int
  principalPaid      Int
  principalBefore    Int
  interestBefore     Int
  penaltyBefore      Int
  principalRemaining Int
  interestRemaining  Int
  penaltyRemaining   Int
  totalRemaining     Int
  method             PaymentMethod
  evidenceUrl        String?
  note               String?
  createdAt          DateTime      @default(now())

  @@index([contractId, paidAt])
}

model LoanContractDraft {
  finalizedContractId String?
  id                  String   @id
  borrowerId          String
  dataJson            String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([borrowerId])
}

//---------------------------------------------------
// Company and Branch
//---------------------------------------------------

enum CompanySequenceType {
  COMPANY
  BRANCH
}

enum CompanySequenceStatus {
  ACTIVE
  INACTIVE
}

model CompanySequence {
  paymentBankCode      String?
  paymentAccountNumber String?
  paymentAccountName   String?
  paymentQrUrl         String?

  owner               CompanyOwner?
  ownerNationalId     String?
  ownerAddress        String?
  ownerDocumentUrl    String?
  ownerDocumentName   String?
  ownerFirstName      String?
  ownerLastName       String?
  ownerPhone          String?
  ownerEmail          String?
  ownerProvince       String?
  ownerDistrict       String?
  ownerSubdistrict    String?
  ownerMoo            String?
  ownerSoi            String?
  ownerRoad           String?
  ownerProvinceId     Int?
  ownerDistrictId     Int?
  ownerSubdistrictId  Int?
  ownerProvinceRef    Province?     @relation("CompanyOwnerProvince", fields: [ownerProvinceId], references: [id], onDelete: SetNull)
  ownerDistrictRef    District?     @relation("CompanyOwnerDistrict", fields: [ownerDistrictId], references: [id], onDelete: SetNull)
  ownerSubdistrictRef Subdistrict?  @relation("CompanyOwnerSubdistrict", fields: [ownerSubdistrictId], references: [id], onDelete: SetNull)

  houseNo                 String?
  moo                     String?
  soi                     String?
  road                    String?
  provinceId              String?
  districtId              String?
  subdistrictId           String?
  id                      String                @id @default(cuid())
  companycode             String                @unique
  logo                    String?
  nameTH                  String?
  nameEN                  String?
  TaxIdentificationNumber String?
  aboutus                 String?
  companyoverview         String?
  address                 String?
  postcode                String?
  phone                   String?
  email                   String?
  type                    CompanySequenceType
  status                  CompanySequenceStatus @default(ACTIVE)
  branches                BranchCodeSequence[]
  userAccess              UserCompanyAccess[]

  @@index([ownerProvinceId])
  @@index([ownerDistrictId])
  @@index([ownerSubdistrictId])
}

model CompanyOwner {
  id          String          @id @default(cuid())
  companyCode String          @unique
  company     CompanySequence @relation(fields: [companyCode], references: [companycode], onDelete: Cascade, onUpdate: Cascade)

  ownerNationalId     String?
  ownerPrefix         String?
  ownerFirstName      String?
  ownerLastName       String?
  ownerPhone          String?
  ownerEmail          String?
  ownerAddress        String?
  ownerMoo            String?
  ownerSoi            String?
  ownerRoad           String?
  ownerProvince       String?
  ownerDistrict       String?
  ownerSubdistrict    String?
  ownerPostcode       String?
  ownerProvinceId     Int?
  ownerDistrictId     Int?
  ownerSubdistrictId  Int?
  ownerProvinceRef    Province?    @relation("CompanyOwnerPostcodeProvince", fields: [ownerProvinceId], references: [id], onDelete: SetNull)
  ownerDistrictRef    District?    @relation("CompanyOwnerPostcodeDistrict", fields: [ownerDistrictId], references: [id], onDelete: SetNull)
  ownerSubdistrictRef Subdistrict? @relation("CompanyOwnerPostcodeSubdistrict", fields: [ownerSubdistrictId], references: [id], onDelete: SetNull)
  ownerDocumentUrl    String?
  ownerDocumentName   String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([ownerProvinceId])
  @@index([ownerDistrictId])
  @@index([ownerSubdistrictId])
}

model BranchCodeSequence {
  paymentBankCode      String?
  paymentAccountNumber String?
  paymentAccountName   String?
  paymentQrUrl         String?

  houseNo                 String?
  moo                     String?
  soi                     String?
  road                    String?
  provinceId              String?
  districtId              String?
  subdistrictId           String?
  id                      String                @id @default(cuid())
  companycode             String
  branchcode              String                @unique
  logo                    String?
  nameTH                  String?
  nameEN                  String?
  TaxIdentificationNumber String?
  aboutus                 String?
  companyoverview         String?
  address                 String?
  postcode                String?
  phone                   String?
  email                   String?
  type                    CompanySequenceType
  status                  CompanySequenceStatus @default(ACTIVE)
  company                 CompanySequence       @relation(fields: [companycode], references: [companycode], onDelete: Cascade, onUpdate: Cascade)

  @@index([companycode])
}

//---------------------------------------------------
// Admin
//---------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

// Better Auth identities are separate from business contact records.
model User {
  id               String              @id @default(cuid())
  name             String
  username         String?             @unique
  email            String              @unique
  emailVerified    Boolean             @default(false)
  image            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  role             String?             @default("staff")
  status           UserStatus          @default(ACTIVE)
  accessConfigured Boolean             @default(false)
  banned           Boolean?            @default(false)
  banReason        String?
  banExpires       DateTime?
  sessions         Session[]
  accounts         Account[]
  profile          UserProfile?
  companyAccess    UserCompanyAccess[]
  appAccess        UserAppAccess[]
  menuAccess       UserMenuAccess[]
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String   @default("")
  lastName  String   @default("")
  phone     String   @default("")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastName, firstName])
}

model UserCompanyAccess {
  id          String          @id @default(cuid())
  userId      String
  companyCode String
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     CompanySequence @relation(fields: [companyCode], references: [companycode], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, companyCode])
  @@index([companyCode])
}

model UserAppAccess {
  id        String   @id @default(cuid())
  userId    String
  appKey    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appKey])
  @@index([appKey])
}

model UserMenuAccess {
  id        String   @id @default(cuid())
  userId    String
  href      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, href])
  @@index([href])
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String   @default("")
  permissions String   @default("[]")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//---------------------------------------------------
// YouTube Family Subscription
//---------------------------------------------------
model YoutubeFamilySubscription {
  id         String @id @default(cuid())
  familyName String
  mailacc    String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model YoutubeMember {
  id           String                 @id @default(cuid())
  name         String                 @unique
  contactEmail String?
  phone        String?
  line         String?
  facebook     String?
  instagram    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  accounts     YoutubeMemberAccount[]
}

model YoutubeMemberAccount {
  id        String               @id @default(cuid())
  memberId  String
  email     String               @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  member    YoutubeMember        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  seats     YoutubeBillingSeat[]

  @@index([memberId])
}

model YoutubeBillingGroup {
  id        String               @id @default(cuid())
  importKey String               @unique
  name      String
  dueDay    Int?
  status    String               @default("DRAFT")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  seats     YoutubeBillingSeat[]

  @@index([status])
}

model YoutubeBillingSeat {
  id            String                @id @default(cuid())
  groupId       String
  position      Int
  sourceRowKey  String                @unique
  displayName   String?
  email         String?
  contactMethod String?
  billingMonths Int?
  sourceStatus  String?
  priceSatang   Int?
  paymentStatus String                @default("UNRECORDED")
  accountId     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  group         YoutubeBillingGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberAccount YoutubeMemberAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([groupId, position])
  @@index([groupId])
  @@index([email])
  @@index([paymentStatus])
  @@index([accountId])
}

// Loan operations: identity records are referenced by ID and financial rows keep snapshots.
model LoanInvestor {
  createdBy  String   @default(" ")
  id         String   @id @default(cuid())
  nationalId String   @unique
  title      String
  firstName  String
  lastName   String
  phone      String
  email      String   @default("")
  address    String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LoanFollowUp {
  id             String   @id @default(cuid())
  contractId     String
  outcome        String
  note           String
  assigneeId     String?
  assigneeName   String?
  promisedAt     DateTime?
  promisedAmount Int      @default(0)
  status         String   @default("OPEN")
  createdBy      String
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  @@index([contractId, createdAt])
  @@index([status, promisedAt])
}

model LoanCapitalRequest {
  id               String   @id @default(cuid())
  requestKey       String   @unique
  direction        String
  amount           Int
  companyCode      String
  branchCode       String
  investorId       String?
  investorSnapshot String?
  method           String
  reference        String
  note             String
  status           String   @default("PENDING")
  requestedBy      String
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNote       String?
  ledgerEntryId    String?  @unique
  createdAt        DateTime @default(now())
  @@index([status, createdAt])
}

model LoanAccountingPeriod {
  snapshot    String?
  id          String   @id @default(cuid())
  companyCode String
  throughDate DateTime
  status      String   @default("CLOSED")
  reason      String
  createdBy   String
  reopenedBy  String?
  reopenedAt  DateTime?
  createdAt   DateTime @default(now())
  @@index([companyCode, status, throughDate])
}

model LoanReconciliation {
  id              String   @id @default(cuid())
  companyCode     String
  asOf            DateTime
  method          String
  reference       String
  statementAmount Int
  ledgerAmount    Int
  difference      Int
  note            String
  createdBy       String
  createdAt       DateTime @default(now())
  @@index([companyCode, asOf])
}

model LoanCashPlan {
  id          String   @id @default(cuid())
  companyCode String
  direction   String
  title       String
  amount      Int
  dueDate     DateTime
  status      String   @default("OPEN")
  createdBy   String
  createdAt   DateTime @default(now())
  @@index([companyCode, status, dueDate])
}
