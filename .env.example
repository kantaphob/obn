DATABASE_URL="file:./dev.db"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="generate-a-32-byte-secret-before-deploying"

# Optional AISC-compatible reader service override. Empty uses the local PC/SC reader directly.
AISC_SMARTCARD_API_URL=""
# Optional bearer token if the local reader service requires authentication.
AISC_SMARTCARD_API_TOKEN=""

# Google Sheets: share the spreadsheet with the service account as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_TAB_NAME="ชีต1"
# Absolute path outside public/; never commit the JSON key.
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=""
